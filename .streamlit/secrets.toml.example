# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
OPENAI_API_KEY = "sk-..."
APP_PASSWORD = "choose-a-password"
# Building types offered (comma-separated); leave out for all of them:
# residential, office, hotel, hotel_apartments, car_parking, retail, schools, universities
BUILDING_TYPES = "residential"
# Optional overrides
# TEXT_MODEL = "gpt-5.4-mini"
# IMAGE_MODEL = "gpt-image-2.6-flare"
